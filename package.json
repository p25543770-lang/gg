{
  "name": "stereo-space",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "test:desktop": "node --test tests/desktop.check.cjs",
    "build:win": "npm run build && node scripts/check-desktop-assets.cjs && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "description": "Local two-camera stereo reconstruction and hamster detection",
  "author": "Stereo Space contributors",
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.stereospace.app",
    "productName": "Stereo Space",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Stereo-Space-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
